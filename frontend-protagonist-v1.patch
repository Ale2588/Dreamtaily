+function valueOf(id) {
+  const value = document.getElementById(id)?.value?.trim();
+  return value || null;
+}
+
+function splitList(value) {
+  return (value || '').split(',').map(item => item.trim()).filter(Boolean).slice(0, 8);
+}
+
+function selectProtagonistType(type) {
+  state.protagonist.type = type;
+  document.querySelectorAll('.protagonist-type').forEach(button => {
+    button.classList.toggle('selected', button.dataset.protagonistType === type);
+  });
+
+  const isHuman = type === 'real_person';
+  ['human-hair-color','human-hair-style','human-eye-color','human-skin-tone'].forEach(id => {
+    const element = document.getElementById(id);
+    if (element) element.style.display = isHuman ? '' : 'none';
+  });
+  ['fantasy-species','fantasy-body-color','fantasy-body-shape'].forEach(id => {
+    const element = document.getElementById(id);
+    if (element) element.style.display = isHuman ? 'none' : '';
+  });
+  updateState();
+}
+
+function updateState() {
+  const ageRaw = valueOf('input-age');
+  const personalityRaw = valueOf('input-personality') || '';
+  const description = valueOf('input-desc') || '';
+  const outfit = valueOf('input-outfit');
+
+  state.name = valueOf('input-name') || '';
+  state.desc = description;
+  state.protagonist = {
+    type: state.protagonist?.type || 'real_person',
+    display_name: state.name,
+    age: ageRaw ? Number(ageRaw) : null,
+    narrative_age_group: valueOf('input-age-group') || '',
+    pronouns: valueOf('input-pronouns'),
+    short_description: description,
+    personality: splitList(personalityRaw),
+    interests: [],
+    appearance: {
+      species: valueOf('input-species'),
+      hair_color: valueOf('input-hair-color'),
+      hair_style: valueOf('input-hair-style'),
+      eye_color: valueOf('input-eye-color'),
+      skin_tone: valueOf('input-skin-tone'),
+      body_color: valueOf('input-body-color'),
+      body_shape: valueOf('input-body-shape'),
+      default_outfit: {
+        top: outfit,
+        bottom: null,
+        shoes: null,
+        accessory: state.protagonist?.type === 'real_person' ? null : outfit
+      },
+      distinctive_features: []
+    }
+  };
+  updateProceedBtn();
+}
+
+function protagonistIsValid() {
+  const protagonist = state.protagonist;
+  if (!protagonist?.display_name || !protagonist.narrative_age_group) return false;
+  if (protagonist.type !== 'real_person' && !protagonist.appearance.species) return false;
+  return true;
+}
