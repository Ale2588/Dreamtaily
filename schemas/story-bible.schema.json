            "skin_tone": {
              "type": [
                "string",
                "null"
              ]
            },
            "clothing": {
              "type": [
                "string",
                "null"
              ]
            },
            "distinctive_traits": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 12
            },
            "unknown_fields": {
              "type": "array",
