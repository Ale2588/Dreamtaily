            "sounds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "textures": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "scents": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 12
            }
          }
        }
      }
