  "required": [
    "version",
    "language",
    "target_age",
    "protagonist",
    "companion",
    "world",
    "themes",
    "tone",
    "moral",
    "narrative_constraints",
    "continuity_rules"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "language": {
