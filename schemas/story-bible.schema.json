        "no_graphic_violence": {
          "type": "boolean",
          "const": true
        },
        "no_horror": {
          "type": "boolean",
          "const": true
        },
        "no_abandonment": {
          "type": "boolean",
          "const": true
        },
        "age_appropriate_language": {
          "type": "boolean",
          "const": true
